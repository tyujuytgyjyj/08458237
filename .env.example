# ============================================================
#  Cosmos AI — نموذج إعدادات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env إلى Git.
# ============================================================

# ---------- السيرفر ----------
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=1
ENABLE_SECURE_COOKIES=true
SESSION_MAX_AGE=7776000000
MAX_FILE_SIZE=52428800
MAX_FILE_COUNT=5
MAX_BODY_SIZE=25mb

# ---------- الروابط ----------
# عنوان النشر الكامل (يُستخدم في روابط البريد والاشتراك)
PUBLIC_URL=https://your-domain.com
MAIN_URL=https://your-domain.com
APP_URL=
ALLOWED_ORIGINS=

# ---------- الأمان ----------
# استخدم قيمًا عشوائية طويلة (32 حرفًا على الأقل)
SESSION_SECRET=replace-with-a-long-random-secret
CSRF_TOKEN_SECRET=replace-with-another-long-random-secret
OAUTH_STATE_SECRET=replace-with-another-long-random-secret
RESTRICTION_ADMIN_SECRET=replace-with-a-strong-admin-secret
ADMIN_ENABLED=true
ADMIN_EMAIL=you@example.com
# مفتاح اختياري لعملاء OpenAI-compatible
COSMOS_API_KEY=

# ---------- Gemini ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=
# النموذج الأساسي والسرعة/الرؤية/الصور
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BASE_URL=
GEMINI_TIMEOUT_MS=120000
# رد توضيحي عند تعذّر الوصول إلى Gemini (بدل خطأ فارغ)
DEMO_FALLBACK=true
# يفعّل إظهار رمز الدخول عند فشل البريد (للتجربة فقط)
DEMO_MODE=false
SYSTEM_PROMPT=

# ---------- حدود الاستخدام اليومية ----------
GUEST_DAILY_MESSAGES=50
FREE_DAILY_MESSAGES=200
PREMIUM_DAILY_MESSAGES=0

# ---------- التخزين ----------
STORAGE_DIR=./data
# اختياري: PostgreSQL. اتركه فارغًا لاستخدام ملف JSON.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_CONNECTION_TIMEOUT=10000
DB_MAX_CLIENTS=5
DB_IDLE_TIMEOUT=30000
# اختياري: Redis لتخزين الجلسات/الحدود (يوجد fallback داخلي)
REDIS_URL=

# ---------- البريد الإلكتروني (دخول بدون كلمة مرور + إشعارات) ----------
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Cosmos AI
EMAIL_FROM_ADDR=
ADMIN_EMAIL=

# ---------- Google OAuth ----------
# أضف https://your-domain.com/auth/google/callback في Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# اتركهما فارغين لإنشاء السعر تلقائيًا من السعر المحدد في الكود
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# سر Webhook من لوحة Stripe (انقر "اختبار" أو "إرسال حدث")
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ---------- حماية النماذج/البوتات ----------
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITE_KEY=
ENFORCE_CAPTCHA=false

# ---------- حماية الواجهة البرمجية ----------
ANTI_CLI_MODE=strict
ANTI_CLI_DISABLE=false
ANTI_CLI_LOOPBACK_WHITELIST=true
ANTI_CLI_HONEYPOT_PREFIXES=/__/,/x/,/dev-only/
ANTI_CLI_LOG_FILE=security_logs/anti-cli-rejections.log
ANTI_CLI_BLOCK_TTL_MS=3600000
ANTI_CLI_SLOWDOWN_ENABLE=true
ANTI_CLI_SLOWDOWN_MS=1200
ANTI_CLI_ALLOWED_ORIGINS=
API_KEYS=
